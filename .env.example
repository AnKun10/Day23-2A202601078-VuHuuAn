# LLM API key (required — pick one)
GEMINI_API_KEY=AIza...
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# Optional: override default model
# LLM_MODEL=gemini-2.5-flash

# Optional: real HITL interrupts (default: mock approval).
# The FastAPI console (cli serve) turns this on automatically.
# LANGGRAPH_INTERRUPT=true

# Optional: use the LLM-as-judge path in evaluate_node (default: heuristic)
# LAB_LLM_JUDGE=true

# Optional: SQLite file backing the HITL console runs
# LAB_API_DB=outputs/api_runs.sqlite

# Optional: persistence backend
CHECKPOINTER=memory
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/langgraph_lab

LOG_LEVEL=INFO
